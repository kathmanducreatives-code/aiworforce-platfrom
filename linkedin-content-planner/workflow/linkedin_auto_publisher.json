{
    "name": "LinkedIn Auto-Publisher (Daily Cron)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 8,
                            "triggerAtMinute": 0
                        }
                    ]
                }
            },
            "id": "lap-cron-trigger",
            "name": "Daily 8 AM Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{ $env.SUPABASE_URL }}/rest/v1/linkedin_posts?status=eq.Planned&scheduled_date=eq.{{ $now.format('yyyy-MM-dd') }}&select=*",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "={{ $env.SUPABASE_KEY }}"
                        },
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.SUPABASE_KEY }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "lap-fetch-todays-posts",
            "name": "Fetch Today's Posts",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                250,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// Split array response into individual items\nconst items = $input.first().json;\nif (!Array.isArray(items) || items.length === 0) {\n  return [{ json: { skip: true, message: 'No posts scheduled for today.' } }];\n}\nreturn items.map(post => ({ json: { ...post, skip: false } }));"
            },
            "id": "lap-split-posts",
            "name": "Split Posts",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.skip }}",
                            "value2": false
                        }
                    ]
                }
            },
            "id": "lap-filter-skip",
            "name": "Has Posts?",
            "type": "n8n-nodes-base.filter",
            "typeVersion": 2,
            "position": [
                700,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.linkedin.com/v2/ugcPosts",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.LINKEDIN_ACCESS_TOKEN }}"
                        },
                        {
                            "name": "X-Restli-Protocol-Version",
                            "value": "2.0.0"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"author\": \"urn:li:person:{{ $env.LINKEDIN_PERSON_URN }}\",\n  \"lifecycleState\": \"PUBLISHED\",\n  \"specificContent\": {\n    \"com.linkedin.ugc.ShareContent\": {\n      \"shareCommentary\": {\n        \"text\": {{ JSON.stringify($json.post_caption) }}\n      },\n      \"shareMediaCategory\": \"NONE\"\n    }\n  },\n  \"visibility\": {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n}",
                "options": {}
            },
            "id": "lap-post-to-linkedin",
            "name": "Post to LinkedIn",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                950,
                0
            ]
        },
        {
            "parameters": {
                "method": "PATCH",
                "url": "={{ $env.SUPABASE_URL }}/rest/v1/linkedin_posts?id=eq.{{ $('Split Posts').item.json.id }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "={{ $env.SUPABASE_KEY }}"
                        },
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.SUPABASE_KEY }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "Prefer",
                            "value": "return=minimal"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{ \"status\": \"Posted\" }",
                "options": {}
            },
            "id": "lap-update-status",
            "name": "Mark as Posted",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1200,
                0
            ]
        }
    ],
    "connections": {
        "Daily 8 AM Trigger": {
            "main": [
                [
                    {
                        "node": "Fetch Today's Posts",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Today's Posts": {
            "main": [
                [
                    {
                        "node": "Split Posts",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Split Posts": {
            "main": [
                [
                    {
                        "node": "Has Posts?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Has Posts?": {
            "main": [
                [
                    {
                        "node": "Post to LinkedIn",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Post to LinkedIn": {
            "main": [
                [
                    {
                        "node": "Mark as Posted",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}