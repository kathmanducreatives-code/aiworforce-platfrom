# Copy to .env.local and fill in real values. NEVER commit .env or .env.local.

# ── Server-side only (used by edge functions / server tooling; NO VITE_ prefix) ──
# Firecrawl key — must NOT be bundled to the frontend. Move call sites to an
# edge function before re-enabling Firecrawl-backed features in the UI.
FIRECRAWL_API_KEY=

# ── Frontend (Vite-bundled, anything VITE_* is public in the browser) ──
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# n8n webhooks for lead scraping / advanced search. These URLs are public-ish
# (anyone with the URL can POST), so keep n8n endpoints unguessable.
VITE_N8N_LEAD_SCRAPER_WEBHOOK_URL=
VITE_N8N_ADVANCED_SEARCH_WEBHOOK_URL=
