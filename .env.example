# Public frontend config
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Lead scraping webhooks (point these to your n8n workflows)
VITE_N8N_LEAD_SCRAPER_WEBHOOK_URL=
VITE_N8N_ADVANCED_SEARCH_WEBHOOK_URL=

# IMPORTANT
# Do not place APIFY_API_TOKEN or FIRECRAWL_API_KEY in VITE_ variables.
# Keep those secrets in n8n credentials (or another server-side runtime).
